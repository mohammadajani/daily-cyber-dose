# Copy this file to .env and fill in your real values. Never commit .env.

# Priority list of LLM backends, comma separated. Tried left to right; the
# first one that (a) has an API key set below AND (b) actually responds
# wins for that call. If a provider deprecates your model or goes down,
# just reorder this list or add a new one — no code changes needed.
# Options: groq, cerebras, openrouter, together, local, gemini
LLM_PROVIDERS=groq,gemini

# --- Groq (https://console.groq.com/keys) — free tier, no card needed ---
# llama-3.3-70b-versatile was deprecated by Groq in June 2026;
# openai/gpt-oss-120b is their recommended replacement.
# Swapping this to another model (e.g. qwen/qwen3.6-27b) is safe — the
# script detects the model family and sends whatever reasoning_effort
# vocabulary that family actually accepts (they're not the same one).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Gemini (https://aistudio.google.com/apikey) — free tier ---
# gemini-2.0-flash was shut down June 2026; gemini-3.1-flash-lite is the
# current free-tier-friendly recommendation.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# --- Optional extra providers, only used if listed in LLM_PROVIDERS above ---

# Cerebras (https://cloud.cerebras.ai/) — free tier, very fast inference
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama-3.3-70b

# OpenRouter (https://openrouter.ai/keys) — gateway to many free/paid models
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-120b:free

# Together AI (https://api.together.ai/) — has an always-free Llama model
TOGETHER_API_KEY=
TOGETHER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo-Free

# Local Ollama / LM Studio server — fully offline, never gets deprecated.
# No API key needed for most local setups.
LOCAL_LLM_BASE_URL=http://localhost:11434/v1/chat/completions
LOCAL_LLM_API_KEY=not-needed
LOCAL_LLM_MODEL=llama3.1

# --- Behavior tuning (all optional — sensible defaults if left unset) ---

# Per-category criticality override, comma separated "Category:threshold".
# Anything not listed falls back to CRITICALITY_THRESHOLD above. Category
# names must match the "# --- Section Name ---" headers in feeds.txt.
# Example: newsletters aren't urgent by nature, so hold them to a higher bar.
CATEGORY_THRESHOLDS=Newsletters:7

# How many days of "seen" history to keep in hermes.db before pruning.
SEEN_RETENTION_DAYS=90

# Feed-fetching concurrency and per-feed timeout (seconds).
FEED_FETCH_WORKERS=10
FEED_FETCH_TIMEOUT=15

# If an article's RSS snippet is shorter than this many characters, fetch
# the full article page instead (only for articles that already cleared
# triage). 0 disables this.
FULL_ARTICLE_MIN_SNIPPET_CHARS=0
FULL_ARTICLE_MAX_CHARS=4000

# Hard per-article cap on how much RSS snippet content goes into a
# summarize prompt, regardless of what any feed provides. Some
# newsletter/roundup feeds put their whole body in <description> —
# without this cap, one bloated feed entry can blow up the combined
# request size and get rejected (413 Payload Too Large).
MAX_SNIPPET_CHARS_FOR_SUMMARY=2000

# Optional second Telegram chat for the highest-scoring items, so a real
# 0-day doesn't get buried among routine CVEs. Leave blank to disable —
# everything goes to TELEGRAM_CHAT_ID as usual.
TELEGRAM_CRITICAL_CHAT_ID=
CRITICAL_SPLIT_SCORE=8

# SQLite database file (seen links + sent-article history) and the
# structured JSON-lines event log. Both relative to the script's directory.
DB_FILE=hermes.db
RUN_LOG_FILE=run_events.jsonl

# Telegram bot — create via @BotFather, get chat_id via @userinfobot or getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Articles older than this many hours are skipped entirely (never triaged,
# never summarized) and marked seen so they aren't rechecked every run.
# Some CERT/advisory feeds return their ENTIRE historical archive rather
# than just recent items — this keeps that from flooding a run.
MAX_ARTICLE_AGE_HOURS=72

# How many sent/seen article URLs to remember before trimming the oldest.
# Bumped from an original default of 2000 — a large feed list (lots of CVE
# streams) can blow past that fast; higher = less frequent trimming.
SEEN_HISTORY_CAP=8000

# Safety cap so one run never floods your chat / burns your rate limit
# (this caps how many articles get EVALUATED per run, not just sent)
MAX_NEW_ARTICLES_PER_RUN=15

# How many articles go into ONE LLM call (batched, not one-request-per-article).
# Keep this <= MAX_NEW_ARTICLES_PER_RUN; a run with more than this many new
# articles just makes multiple batch calls instead of one.
EVAL_BATCH_SIZE=15

# Articles are scored 1-10 for criticality by the LLM. Only ones scoring
# at or above this get sent to Telegram; the rest are marked seen and
# skipped (not re-evaluated, so they don't cost quota again).
CRITICALITY_THRESHOLD=5
